// STAR LIFE CLINIC — Dr. Mahesh Kumar
// Database schema (Prisma / PostgreSQL — Supabase-compatible)
// Runs unchanged on a local embedded Postgres and on Supabase: switching
// between them is only a DATABASE_URL change (no code or schema edits).
// NOTE: Prisma enums are not used — status/gender are stored as constrained
// strings validated at the application boundary (zod).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Clinic {
  id          String   @id @default(cuid())
  name        String
  description String?
  phone       String
  address     String
  mapsUrl     String?
  timezone    String   @default("Asia/Kolkata")
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors      Doctor[]
  services     Service[]
  clinicHours  ClinicHour[]
  blockedDates BlockedDate[]
  blockedSlots BlockedSlot[]
  appointments Appointment[]

  @@map("clinics")
}

model Doctor {
  id              String   @id @default(cuid())
  clinicId        String
  name            String
  photoUrl        String?
  bio             String?
  qualifications  String?
  specializations String?
  experience      String?
  /// Inactive doctors are hidden from booking but keep their history.
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([clinicId])
  @@map("doctors")
}

model Service {
  id              String   @id @default(cuid())
  clinicId        String
  name            String
  description     String?
  durationMinutes Int      @default(30)
  price           Float?
  isActive        Boolean  @default(true)
  isDemo          Boolean  @default(false) // marks clearly-labelled demo seed rows
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([clinicId, isActive])
  @@map("services")
}

model ClinicHour {
  id          String  @id @default(cuid())
  clinicId    String
  dayOfWeek   Int // 0 = Sunday ... 6 = Saturday
  openingTime String // "16:00" 24h
  closingTime String // "21:30" 24h
  isOpen      Boolean @default(true)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
  @@map("clinic_hours")
}

model BlockedDate {
  id        String   @id @default(cuid())
  clinicId  String
  date      String // YYYY-MM-DD (clinic-local)
  reason    String?
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@index([clinicId, date])
  @@map("blocked_dates")
}

model BlockedSlot {
  id        String   @id @default(cuid())
  clinicId  String
  date      String // YYYY-MM-DD
  startTime String // HH:MM
  endTime   String // HH:MM
  reason    String?
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, date])
  @@map("blocked_slots")
}

model Patient {
  id           String   @id @default(cuid())
  // Login identity: email + password. Phone is NOT a login method — it is
  // optional profile/contact data collected when the patient applies for a
  // consultation (booking details step). Both fields stay nullable because
  // guest bookings create phone-only records without an account.
  email        String?  @unique
  passwordHash String? // scrypt$N$r$p$salt$hash — null for guest (phone-only) records
  /// Supabase Auth user id (auth.users.id) when the account was created via
  /// Supabase. Plain unique column on purpose: auth.users lives in another
  /// schema, which Prisma cannot reference with an FK.
  authUid      String?  @unique
  phone        String?  @unique // optional; captured at booking / profile
  fullName     String?
  age          Int?
  gender       String? // MALE | FEMALE | OTHER
  /// Password reset (own-token flow): SHA-256 of the one-time token + expiry.
  /// Works in both auth modes — in Supabase mode the new password is pushed
  /// to auth.users via the service-role API at reset time.
  resetTokenHash String?   @unique
  resetExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments  Appointment[]
  notifications Notification[]

  @@map("profiles")
}

model Appointment {
  id              String   @id @default(cuid())
  clinicId        String
  doctorId        String
  serviceId       String
  patientId       String
  code            String   @unique // SL-20260912-001
  appointmentDate String // YYYY-MM-DD (clinic-local)
  startTime       String // HH:MM
  endTime         String // HH:MM
  status          String   @default("PENDING") // PENDING|CONFIRMED|COMPLETED|CANCELLED|REJECTED|NO_SHOW
  /// "${doctorId}|${appointmentDate}|${startTime}" while the appointment holds a
  /// slot (PENDING/CONFIRMED); NULL once terminal. Postgres unique indexes are
  /// NULLS DISTINCT by default, so cancelled slots become bookable again
  /// while active bookings remain race-protected.
  slotKey         String?
  /// Contact number given on the booking form for THIS appointment (the
  /// clinic calls this). Snapshot — independent of the account profile phone.
  contactPhone    String?
  patientNotes    String?
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Hard DB-level guard against double booking the exact same slot.
  @@unique([slotKey])
  @@index([clinicId, appointmentDate, status])
  @@index([patientId, appointmentDate])
  @@map("appointments")
}

model Notification {
  id          String   @id @default(cuid())
  patientId   String
  title       String
  body        String
  type        String   @default("GENERAL") // BOOKING|STATUS|REMINDER|SCHEDULE|GENERAL
  referenceId String? // e.g. appointment id — used for idempotent reminders
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, read])
  @@index([patientId, type, referenceId])
  @@map("notifications")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String // scrypt$N$r$p$salt$hash
  role         String   @default("ADMIN") // ADMIN | STAFF
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model AppSetting {
  key   String @id
  value String

  @@map("app_settings")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String // APP_OPENED | BOOKING_STARTED | BOOKING_COMPLETED | APPOINTMENT_CANCELLED | DIRECTIONS_CLICKED | CALL_CLICKED
  metadata  String? // JSON — non-personal only
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@map("analytics_events")
}
